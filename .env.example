# 主力模型，格式為 <provider>:<model>
LLM_MODEL=google_genai:gemini-3.8-flash
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

ETHERSCAN_API_KEY=
# live：直接查詢，record：查詢並存快照，replay：只讀快照
CHAIN_MODE=live

MAX_DEPTH=3
MAX_TOOL_CALLS=25
MAX_ADDRESSES=20
MAX_TOKENS=200000

# 選配：以下為預設值，需要時取消註解調整
# TOP_COUNTERPARTIES=10
# SUPPLEMENT_TOOL_CALLS=10
# MAX_REVIEW_ROUNDS=3
# ETHERSCAN_MIN_INTERVAL=0.25
# TX_PAGE_SIZE=100
# 連續幾次工具呼叫未發現風險後提示收尾
# WRAP_UP_HINT_AFTER=6
# 原生 ETH 粉塵門檻
# NATIVE_DUST_THRESHOLD=0.0001
# 單次 LLM 呼叫逾時秒數
# LLM_TIMEOUT=120

# 選配：LangSmith trace
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
