# 主力模型，格式為 <provider>:<model>
LLM_MODEL=google_genai:gemini-3.8-flash
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

ETHERSCAN_API_KEY=
# live：直接查詢，record：查詢並存快照，replay：只讀快照
CHAIN_MODE=live

MAX_DEPTH=3
MAX_TOOL_CALLS=25
MAX_ADDRESSES=20
MAX_TOKENS=200000

# 選配：LangSmith trace
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
